// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TECNICO
  CLIENTE
}

enum MeterStatus {
  ACTIVO
  DANADO
  SUSPENDIDO
}

enum InvoiceStatus {
  PENDIENTE
  PAGADO
  VENCIDO
}

enum CutStatus {
  PENDIENTE
  EJECUTADO
  RECONEXION
}

enum PaymentMethod {
  EFECTIVO
  QR
  TRANSFERENCIA
}

model User {
  id String @id @default(cuid())

  email    String @unique
  password String

  role        Role
  fullName    String? // <-- NUEVO: Para el perfil del Admin/Técnico
  avatarUrl   String? // <-- NUEVO: Para la foto de perfil
  fcmToken    String? // <-- NUEVO: Para enviarle notificaciones Push
  isActive    Boolean   @default(true)
  lastLoginAt DateTime? // <-- NUEVO: Para saber su última conexión rápida
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  customer      CustomerProfile?
  workOrders    WorkOrder[]      @relation("TechOrders") // <-- NUEVO
  readings      Reading[]
  cuts          ServiceCut[]
  payments      Payment[]
  notifications Notification[]
  auditLogs     AuditLog[]
  districts     District[] // <-- NUEVO: Relación M:N con Distritos (Zonas asignadas)

  @@index([role])
}

model District {
  id String @id @default(cuid())

  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers   CustomerProfile[]
  technicians User[]
  userId      String?
}

model CustomerProfile {
  id String @id @default(cuid())

  userId     String @unique
  districtId String

  fullName String

  ci        String         @unique
  phone     String?
  address   String
  status    CustomerStatus @default(PENDING_VERIFICATION)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  district   District         @relation(fields: [districtId], references: [id])
  category   CustomerCategory @default(DOMESTICA)
  meters     Meter[]
  invoices   Invoice[]
  cuts       ServiceCut[]
  workOrders WorkOrder[]

  @@index([districtId])
}

enum MeterType {
  MECANICO
  ULTRASONICO // IoT
}

model Meter {
  id String @id @default(cuid())

  customerId String? // <-- OPCIONAL (Medidores en almacén)
  code       String  @unique

  type         MeterType @default(MECANICO) // <-- NUEVO: Para saber la tecnología
  batteryLevel Int? // <-- NUEVO: Nivel de batería para los IoT (null si es mecánico)

  status MeterStatus @default(ACTIVO)

  installedAt DateTime?
  gpsLat      Float?
  gpsLng      Float?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relación opcional
  customer CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  readings   Reading[]
  workOrders WorkOrder[]

  @@index([customerId])
}

model Reading {
  id String @id @default(cuid())

  meterId      String
  technicianId String

  previousReading Float
  currentReading  Float

  consumption Float

  gpsLat Float?
  gpsLng Float?

  photoUrl String?

  createdAt DateTime @default(now())

  meter Meter @relation(fields: [meterId], references: [id])

  technician User @relation(fields: [technicianId], references: [id])

  invoice Invoice?

  @@index([meterId])
  @@index([technicianId])
}

model Invoice {
  id String @id @default(cuid())

  customerId String
  readingId  String @unique

  consumption Float

  fixedCharge Float @default(0)

  unitPrice Float

  penaltyAmount Float @default(0)

  subtotal Float

  total Float

  status InvoiceStatus @default(PENDIENTE)

  dueDate DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  customer CustomerProfile @relation(fields: [customerId], references: [id])

  reading Reading @relation(fields: [readingId], references: [id])

  payments Payment[]

  @@index([customerId])
  @@index([status])
}

model Payment {
  id String @id @default(cuid())

  invoiceId String
  userId    String

  amount Float

  method PaymentMethod

  reference String?

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id])

  @@index([invoiceId])
  @@index([userId])
}

model ServiceCut {
  id String @id @default(cuid())

  customerId   String
  technicianId String?

  reason String

  status CutStatus @default(PENDIENTE)

  gpsLat Float?
  gpsLng Float?

  photoUrl String?

  createdAt DateTime @default(now())

  customer CustomerProfile @relation(fields: [customerId], references: [id])

  technician User? @relation(fields: [technicianId], references: [id])

  @@index([customerId])
  @@index([technicianId])
}

model Notification {
  id String @id @default(cuid())

  userId String?

  title   String
  message String
  type    String @default("system") // <-- NUEVO: 'alert', 'payment', 'system', 'info'

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id String @id @default(cuid())

  userId String? // <-- ¡CRÍTICO! Quién hizo la acción

  entity   String // Ej. INVOICE, CUSTOMER
  entityId String
  action   String // CREATE, UPDATE, DELETE
  oldData  Json?
  newData  Json?

  ipAddress String? // <-- (Opcional, pero muy recomendado)

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id]) // Relación

  @@index([entity])
  @@index([entityId])
  @@index([userId])
}

enum CustomerCategory {
  SOLIDARIA
  DOMESTICA
  COMERCIAL
  CONDOMINIO
}

enum CustomerStatus {
  PENDING_VERIFICATION // <-- Cuando recién se registra
  ACTIVE // <-- Cuando el técnico instala el medidor
  SUSPENDED // <-- Por cortes
}

enum WorkOrderType {
  INSTALLATION
  READING
  CUT
  RECONNECTION
}

enum WorkOrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model WorkOrder {
  id     String          @id @default(cuid())
  type   WorkOrderType
  status WorkOrderStatus @default(PENDING)

  technicianId String
  customerId   String?
  meterId      String? // Se llenará al instalar

  description  String?
  scheduledFor DateTime // Cuándo debe ir el técnico

  // Evidencia (Se llena cuando el técnico finaliza)
  executionLat Float?
  executionLng Float?
  photoUrl     String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  technician User             @relation("TechOrders", fields: [technicianId], references: [id])
  customer   CustomerProfile? @relation(fields: [customerId], references: [id])
  meter      Meter?           @relation(fields: [meterId], references: [id])

  @@index([technicianId])
  @@index([customerId])
}
